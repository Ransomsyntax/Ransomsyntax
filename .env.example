# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

# --- Core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Email (used for enquiry form notifications) ---
# In development, leave DJANGO_EMAIL_BACKEND on the console backend so
# messages print to the terminal instead of sending real email.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production, switch to: django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=no-reply@ransomsyntax.com

# Inbox that receives new enquiry notifications
ENQUIRY_NOTIFICATION_EMAIL=suryamaxcode@gmail.com

# --- Production only ---
DJANGO_SECURE_SSL_REDIRECT=True
